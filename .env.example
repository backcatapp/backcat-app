# --- Local infra (docker-compose defaults) ---
DATABASE_URL=postgresql://backcat:backcat@localhost:5432/backcat
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=backcatdev

# --- ASR ---
GROQ_API_KEY=

# --- Embeddings (provider-switchable: openai | bge-m3) ---
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=

# --- Extraction + answering ---
ANTHROPIC_API_KEY=

# --- Reranker (day-10 decision: cohere | bge) ---
COHERE_API_KEY=

# --- Serve ---
CORS_ORIGIN=http://localhost:3000
DAILY_SPEND_LIMIT_USD=5
# Shared secret between web Server Actions and serve internal endpoints
INTERNAL_TOKEN=
# web-side: where Server Actions reach serve (server-to-server)
SERVE_INTERNAL_URL=http://localhost:8000
# Keycloak JWT validation (iss must match token; JWKS_URL for Docker-internal fetch)
KEYCLOAK_ISSUER=http://localhost:8080/realms/backcat
# KEYCLOAK_JWKS_URL=http://keycloak:8080/realms/backcat/protocol/openid-connect/certs
# Fernet key for encrypting user BYOK Anthropic keys (Fernet.generate_key())
BYOK_SECRET=

# --- Auth (web/.env.local; dev values match infra/keycloak/backcat-realm.json) ---
AUTH_SECRET=
AUTH_KEYCLOAK_ID=backcat-web
AUTH_KEYCLOAK_SECRET=
AUTH_KEYCLOAK_ISSUER=http://localhost:8080/realms/backcat

# --- Extension (ext/.env or build-time) ---
# VITE_SERVE_URL=http://localhost:8000
# VITE_KEYCLOAK_URL=http://localhost:8080
# VITE_KEYCLOAK_REALM=backcat
# VITE_KEYCLOAK_CLIENT_ID=backcat-ext
