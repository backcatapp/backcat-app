# Shared / documented keys. For host URLs use:
#   .env.development.example  → local (or omit root `.env` entirely)
#   .env.production.example   → EC2 (copy to `.env` on the server)
#
# Compose reads root `.env` for ${PUBLIC_HOST} and derives web/Keycloak/serve URLs.

# --- Local infra (host tools talking to published ports) ---
DATABASE_URL=postgresql://backcat:backcat@localhost:5432/backcat
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=backcatdev

# --- ASR / embeddings / LLM (pipeline/.env) ---
GROQ_API_KEY=
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
COHERE_API_KEY=

# --- Compose public host (optional; default is localhost) ---
# BACKCAT_ENV=development
# PUBLIC_HOST=localhost
INTERNAL_TOKEN=dev-internal-token
BYOK_SECRET=

# --- Auth (web/.env.development or web/.env.local) ---
AUTH_SECRET=
AUTH_KEYCLOAK_ID=backcat-web
AUTH_KEYCLOAK_SECRET=dev-secret-backcat-web
AUTH_KEYCLOAK_ISSUER=http://localhost:8080/realms/backcat
