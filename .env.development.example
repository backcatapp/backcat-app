# Local development — copy to `.env` only if you need overrides.
# Default: leave `.env` absent; docker-compose.yml already defaults to localhost.
#
#   cp .env.development.example .env
#
# Or just delete any production `.env` so localhost defaults apply:
#   rm .env

BACKCAT_ENV=development
PUBLIC_WEB=http://localhost:3000
PUBLIC_KEYCLOAK=http://localhost:8080
PUBLIC_SERVE=http://localhost:8000
INTERNAL_TOKEN=dev-internal-token
