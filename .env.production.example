# Production (EC2) — on the server:
#   cp .env.production.example .env
#   docker compose up -d --build --force-recreate keycloak serve web
#
# PUBLIC_HOST is the only address to change when the Elastic IP / DNS name
# moves. Compose derives http://$PUBLIC_HOST:{3000,8080,8000} from it.
# Do not put this IP in docker-compose.yml or web/.env.* — those read this file.

BACKCAT_ENV=production
PUBLIC_HOST=13.218.89.96
INTERNAL_TOKEN=dev-internal-token
# BYOK_SECRET=   # optional; set a Fernet key in prod
