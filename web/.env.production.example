# Production web — on the server:
#   cp web/.env.production.example web/.env.production
#   cp web/.env.production.example web/.env.local
#
# Compose also injects AUTH_URL / AUTH_KEYCLOAK_ISSUER from root `.env`
# (PUBLIC_WEB / PUBLIC_KEYCLOAK). Keep these in sync with the public IP.

DATABASE_URL=postgresql://backcat:backcat@localhost:5432/backcat

AUTH_SECRET=replace-with-openssl-rand-hex-32
AUTH_KEYCLOAK_ID=backcat-web
AUTH_KEYCLOAK_SECRET=dev-secret-backcat-web
AUTH_KEYCLOAK_ISSUER=http://34.228.39.244:8080/realms/backcat

SERVE_INTERNAL_URL=http://localhost:8000
INTERNAL_TOKEN=dev-internal-token

NEXT_PUBLIC_SERVE_URL=http://34.228.39.244:8000
NEXT_PUBLIC_CHROME_STORE_URL=https://chromewebstore.google.com/detail/backcat/cgcppmgikannjegijbilmecahlfpjgid
