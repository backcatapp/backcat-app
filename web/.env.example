# Product Postgres (same as pipeline / docker compose)
DATABASE_URL=postgresql://backcat:backcat@localhost:5432/backcat

# Auth.js + Keycloak
AUTH_SECRET=generate-me
AUTH_KEYCLOAK_ID=backcat-web
AUTH_KEYCLOAK_SECRET=
AUTH_KEYCLOAK_ISSUER=http://localhost:8080/realms/backcat

# Internal serve (admin channel add)
SERVE_INTERNAL_URL=http://localhost:8000
INTERNAL_TOKEN=dev-internal-token

# Chrome Web Store listing (landing "Add to Chrome" CTA)
NEXT_PUBLIC_CHROME_STORE_URL=https://chromewebstore.google.com/detail/YOUR_ID
