# Local web (Auth.js) — used when BACKCAT_ENV=development or as web/.env.local
#
#   cp web/.env.development.example web/.env.development
#   # and/or:
#   cp web/.env.development.example web/.env.local

DATABASE_URL=postgresql://backcat:backcat@localhost:5432/backcat

AUTH_SECRET=dev-auth-secret-change-me
AUTH_KEYCLOAK_ID=backcat-web
AUTH_KEYCLOAK_SECRET=dev-secret-backcat-web
AUTH_KEYCLOAK_ISSUER=http://localhost:8080/realms/backcat

SERVE_INTERNAL_URL=http://localhost:8000
INTERNAL_TOKEN=dev-internal-token

NEXT_PUBLIC_SERVE_URL=http://localhost:8000
NEXT_PUBLIC_CHROME_STORE_URL=
